# Next.js only reads .env files from apps/web itself, not the repo root —
# copy this to apps/web/.env.local and fill in the same Supabase project
# values you used for apps/api.

NEXT_PUBLIC_SUPABASE_URL="https://<your-project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-public-key>"

# Where the Fastify API is running locally. No NEXT_PUBLIC_ prefix —
# this is only ever read server-side (Server Components/Actions), never
# shipped to the browser.
API_URL="http://localhost:4000"
