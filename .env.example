SUPABASE_URL="https://<your-project-ref>.supabase.co"
SUPABASE_ANON_KEY="<anon-public-key>"          # safe for frontend use
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"  # backend/seed only — never expose to frontend

# Only needed if you keep Prisma for typed app queries against Supabase Postgres
DATABASE_URL="postgresql://postgres:<db-password>@db.<your-project-ref>.supabase.co:5432/postgres"
