SUPABASE_URL="https://<your-project-ref>.supabase.co"
SUPABASE_ANON_KEY="<anon-public-key>"          # safe for frontend use
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"  # backend/seed only — never expose to frontend
# No JWT secret needed — tokens are verified locally against Supabase's
# public JWKS endpoint (derived from SUPABASE_URL), which works whether the
# project uses legacy shared-secret or newer asymmetric signing keys.

# --- Integration tests only: put these in .env.test (gitignored), NOT in your normal .env ---
# Use a separate TEST Supabase project. The tests create/delete data with the service-role key.
# SUPABASE_URL=...
# SUPABASE_ANON_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=...
# Required when SUPABASE_URL is a hosted project (not localhost): confirms it is a throwaway TEST project.
# ALLOW_REMOTE_TEST_DB=1
# Optional runtime settings for the API: FRONTEND_URL (allowed web origin for CORS), PORT (default 4000)
