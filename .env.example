SUPABASE_URL="https://<your-project-ref>.supabase.co"
SUPABASE_ANON_KEY="<anon-public-key>"          # safe for frontend use
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"  # backend/seed only — never expose to frontend
# No JWT secret needed — tokens are verified locally against Supabase's
# public JWKS endpoint (derived from SUPABASE_URL), which works whether the
# project uses legacy shared-secret or newer asymmetric signing keys.

# --- Web app ---
# The web app reads this same file. NEXT_PUBLIC_SUPABASE_URL / _ANON_KEY default to the
# SUPABASE_URL / SUPABASE_ANON_KEY above, so there is nothing to duplicate.
# Where the web server reaches the API:
# API_URL="http://localhost:4000"

# --- API runtime ---
# Origin of the web app, for CORS. If unset: localhost:3000 in development,
# and CORS disabled entirely when NODE_ENV=production (fails closed).
# FRONTEND_URL="https://<your-web-app>.vercel.app"
# PORT=4000

# --- Integration tests only (put these in .env.test, NOT in production .env) ---
# Required when SUPABASE_URL is a hosted project rather than localhost.
# Confirms it is a throwaway TEST project: the tests write/delete data using
# the service-role key. Never set this against a project with real data.
# ALLOW_REMOTE_TEST_DB=1
